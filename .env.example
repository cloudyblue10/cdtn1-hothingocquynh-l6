# ===== Sao chép thành .env rồi sửa nếu cần:  cp .env.example .env  (Windows: copy .env.example .env)
# Tệp .env thật KHÔNG được commit (đã chặn trong .gitignore).

# Thư mục chứa 4 tệp nguồn: orders_2024_2026.csv, order_items.csv, products.csv, stores.csv
#   data/sample  = bộ mẫu 1.500 đơn đã commit (mặc định, chạy được ngay sau khi clone)
#   data/raw     = bộ đầy đủ 26.000 đơn (giải nén từ VLU E-learning, KHÔNG commit)
DATA_DIR=data/sample

# Dữ liệu tham chiếu: tỷ lệ giá vốn theo nhóm sản phẩm, bảng vùng miền
REFERENCE_DIR=data/reference

# Tệp SQLite của kho dữ liệu (tự tạo khi chạy pipeline)
DW_PATH=warehouse/dw_mekong.sqlite

# Nơi ghi báo cáo chất lượng JSON của mỗi lần chạy
REPORT_DIR=reports

# Ngưỡng tỉ lệ hợp lệ tối thiểu (%) để lần nạp được đánh giá ĐẠT
QUALITY_THRESHOLD=95

# Ngưỡng cảnh báo biến động doanh thu ngày so với TB 7 ngày trước (%) — FR-11
ALERT_THRESHOLD=30

# Máy chủ dashboard (Docker tự đặt API_HOST=0.0.0.0)
API_HOST=127.0.0.1
API_PORT=8000
